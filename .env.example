# ──────────────────────────────────────────────────────────────────────
#  Directus CMS (shared BravoByte instance)
# ──────────────────────────────────────────────────────────────────────
# Both DIRECTUS_URL / PRIVATE_DIRECTUS_URL are read by src/lib/server/directus.ts
# (first non-empty wins). PUBLIC_DIRECTUS_URL is exposed to the browser via
# $env/dynamic/public to build /assets/<uuid> URLs for Directus Files.
DIRECTUS_URL="https://cms.bravobyte.co"
DIRECTUS_TOKEN=""                       # Dolce Vita App Service static token (output of scripts/directus/migrate.mjs)
DIRECTUS_SITE_KEY="dolcevita"

PRIVATE_DIRECTUS_URL="https://cms.bravobyte.co"
PRIVATE_DIRECTUS_TOKEN=""               # same value as DIRECTUS_TOKEN

PUBLIC_DIRECTUS_URL="https://cms.bravobyte.co"

# ──────────────────────────────────────────────────────────────────────
#  Directus migration (scripts/directus/migrate.mjs only — not used at runtime)
# ──────────────────────────────────────────────────────────────────────
# Admin-grade token; must be able to write to directus_collections,
# directus_fields, directus_relations, directus_policies, directus_permissions,
# directus_users. DO NOT copy to Vercel — only needed locally to run the
# one-shot M2 migration.
DIRECTUS_ADMIN_TOKEN=""

# ──────────────────────────────────────────────────────────────────────
#  RSVP notifications (Resend) — wired in M5
# ──────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RSVP_NOTIFY_EMAIL="hello@dolcevitact.com"
RSVP_NOTIFY_FROM="Dolce Vita CT <reservations@dolcevitact.com>"

# ──────────────────────────────────────────────────────────────────────
#  Public site
# ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL="https://dolcevitact.com"
